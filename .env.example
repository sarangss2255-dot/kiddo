# ---------------------------------------------------------------------------
# KidDo web app environment configuration
# Copy to .env.local and adjust per environment. No secrets belong here.
# ---------------------------------------------------------------------------

# Base URL used by the webapp/admin API clients.
# Use a relative path (e.g. /api/v1) to route through the Next.js rewrite,
# or an absolute URL to call the API directly from the browser.
NEXT_PUBLIC_API_URL=/api/v1

# Server-side rewrite target used when NEXT_PUBLIC_API_URL is relative.
# API_PROXY_TARGET=https://your-backend.example.com

# OpenAPI document used by the docs portal.
# Defaults to <origin of NEXT_PUBLIC_API_URL>/api-docs.json.
# NEXT_PUBLIC_OPENAPI_URL=https://your-backend.example.com/api-docs.json

# Optional default environment for the docs "Try it out" selector.
# Falls back to the first server declared in the OpenAPI document.
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com/api/v1

# Optional ISR revalidation window (seconds) for the OpenAPI document.
# OPENAPI_REVALIDATE_SECONDS=300

# Canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# Display name used in metadata and the footer.
# NEXT_PUBLIC_SITE_NAME=KidDo

# Direct download URLs for the mobile apps. Default to the APK files in /public.
# NEXT_PUBLIC_CHILD_APP_APK_URL=/kiddo-child-app.apk
# NEXT_PUBLIC_PARENT_APP_APK_URL=/kiddo-parent-app.apk
